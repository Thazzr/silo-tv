{
  "name": "silo-tv",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.service.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "perf:scroll": "vite build --mode perf && playwright test -c playwright.perf.config.ts",
    "verify": "pwsh -NoProfile -File tools/verify.ps1",
    "check:bundle": "node scripts/check-bundle.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "package": "ares-package dist service -o out -n",
    "tv:deploy": "node scripts/tv-deploy.mjs",
    "tv:eval": "node scripts/tv-eval.mjs",
    "tv:profile": "node scripts/tv-profile.mjs",
    "openapi:update": "node scripts/update-openapi.mjs",
    "generate:api": "openapi-typescript openapi/silo-v2.json -o src/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@noriginmedia/norigin-spatial-navigation": "^3.4.0",
    "@tanstack/react-query": "^5.107.1",
    "core-js": "^3.51.0",
    "hls.js": "1.7.3",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@webos-tools/cli": "^3.2.6",
    "es-check": "^9.8.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "git-cliff": "^2.14.2",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "msw": "^3.0.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
